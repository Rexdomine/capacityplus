{
  "name": "capacity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "next build && playwright test",
    "audit:prod": "corepack pnpm audit --prod --audit-level high",
    "validate:content": "node scripts/validate-public-content.mjs",
    "validate:built": "node scripts/validate-public-content.mjs --built",
    "check": "corepack pnpm audit --prod --audit-level high && tsx --test tests/**/*.test.ts && node scripts/validate-public-content.mjs && biome check && next build && node scripts/validate-public-content.mjs --built && playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
